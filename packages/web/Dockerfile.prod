# ==========================================
# Etapa 1: Instalar dependencias
# ==========================================
FROM node:22-alpine AS deps
WORKDIR /app

# Copiar archivos de workspaces y dependencias
COPY package*.json ./
COPY packages/web/package*.json ./packages/web/
COPY packages/shared/package*.json ./packages/shared/

# Instalar dependencias necesarias para la compilación (incluye devDependencies)
RUN npm ci

# ==========================================
# Etapa 2: Construir el Frontend
# ==========================================
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
COPY packages/web/package*.json ./packages/web/
COPY packages/shared/package*.json ./packages/shared/

RUN npm ci

# Copiar código fuente
COPY . .

# Construir aplicación web
RUN npm run build -w web

# ==========================================
# Etapa 3: Imagen de Producción (Nginx)
# ==========================================
FROM nginx:stable-alpine AS runtime

# Copiar la configuración personalizada de Nginx
COPY packages/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar los archivos estáticos generados en la etapa de compilación
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

# Exponer puerto HTTP estándar
EXPOSE 80

# Healthcheck para verificar disponibilidad
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
  CMD wget -q --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
