# ==========================================
# Etapa 1: Instalar dependencias de producción
# ==========================================
FROM node:22-alpine AS deps
WORKDIR /app

# Copiar configuración de workspaces de la raíz y package.json de cada paquete
COPY package*.json ./
COPY packages/api/package*.json ./packages/api/
COPY packages/shared/package*.json ./packages/shared/
COPY packages/web/package*.json ./packages/web/

# Instalar únicamente dependencias de runtime para el monorepo
RUN npm ci --omit=dev

# ==========================================
# Etapa 2: Compilar el código fuente (TypeScript/Prisma)
# ==========================================
FROM node:22-alpine AS build
WORKDIR /app

# Copiar estructura de paquetes
COPY package*.json ./
COPY packages/api/package*.json ./packages/api/
COPY packages/shared/package*.json ./packages/shared/
COPY packages/web/package*.json ./packages/web/

# Instalar todas las dependencias (necesarias para compilación y generación de clientes)
RUN npm ci

# Copiar el código fuente completo
COPY . .

# Generar el cliente de Prisma
RUN npx prisma generate --schema=packages/api/prisma/schema.prisma

# Compilar TypeScript del backend
RUN npx tsc --project packages/api/tsconfig.json

# ==========================================
# Etapa 3: Imagen final de ejecución para Producción (Runtime)
# ==========================================
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

# Eliminar npm, npx y el gestor de paquetes global para hardening y optimización
RUN rm -rf /usr/local/bin/npm /usr/local/bin/npx /usr/local/lib/node_modules/npm

# Crear directorios necesarios y cambiar permisos al usuario 'node'
RUN mkdir -p /app && chown -R node:node /app

# Copiar dependencias de runtime y código compilado
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages/api/dist ./dist
COPY --from=build --chown=node:node /app/packages/api/src/generated/client ./dist/generated/client
COPY --from=build --chown=node:node /app/packages/api/package.json ./package.json
COPY --from=build --chown=node:node /app/packages/api/prisma ./prisma
COPY --from=build --chown=node:node /app/packages/shared ./packages/shared

# Cambiar contexto al usuario sin privilegios 'node'
USER node

# Exponer el puerto de la API y el puerto del PrometheusExporter
EXPOSE 3000
EXPOSE 9464

# Healthcheck utilizando wget (ya que no hay curl ni npm/npx)
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD wget -q --spider http://127.0.0.1:3000/ || exit 1

# Iniciar la aplicación directamente con node
CMD ["node", "dist/app.js"]
